# 复制为 .env(勿提交)。docker-compose 起本地 PG 后可直接用下值。
PORT=3000
DATABASE_URL=postgres://family:family@localhost:5432/family_dev

# --- FPAI Model Provider(经 cc switch / CCR,OpenAI 兼容)---
# 【M3-101A 边界】本阶段 Provider 运行时保持 FakeAiGateway;REAL_EXTERNAL_MODEL_CALL=NOT_AUTHORIZED。
# 以下仅占位说明"如何接 cc switch";真实 key 只在 101A-B 经架构师授权后放本地 .env(已 gitignore),严禁入库。
# FPAI_MODEL_BASE_URL=http://127.0.0.1:<ccswitch_port>/v1
# FPAI_MODEL_API_KEY=<PLACEHOLDER_DO_NOT_COMMIT_REAL_KEY>
# FPAI_MODEL_NAME=<model-name-routed-by-cc-switch>
# FPAI_MODEL_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# MM1-B0 · Provider Selection (neutral variables only)
# ---------------------------------------------------------------------------
# 只声明中性 provider slot,值可以是 registry 中已注册的 provider_id,例如:
#   FPAI_STT_PROVIDER=stt.fake_baseline
#   FPAI_TTS_PROVIDER=tts.fake_baseline
#   FPAI_AVATAR_PROVIDER=avatar.fake_baseline
#
# 真实 provider 只能由 MM1-B1 起在架构师授权后接入。任何真实 API key 请:
#   1. 放在本地 .env(已 gitignore)
#   2. 命名以 provider_id 前缀(如 STT_ALIYUN_ACCESS_KEY / TTS_AZURE_KEY)
#   3. 绝对不得写入代码,不得 commit,不得跨仓库读取
#
FPAI_STT_PROVIDER=stt.fake_baseline
FPAI_TTS_PROVIDER=tts.fake_baseline
FPAI_AVATAR_PROVIDER=avatar.fake_baseline

# 真实 API secrets(占位,MM1-B0 不填,不 commit):
#   STT_ALIYUN_ACCESS_KEY=
#   STT_TENCENT_SECRET_ID=
#   TTS_AZURE_KEY=
#   TTS_MINIMAX_API_KEY=
#   AVATAR_DID_API_KEY=

# ---------------------------------------------------------------------------
# MM1-B1 · Reference Stack A · Azure Speech (STT + TTS)
# ---------------------------------------------------------------------------
# Reference Stack A 用 Azure Speech Realtime STT + Azure Neural TTS 作为
# 第一套真实 provider 参考栈。**Azure 不是最终商业绑定厂商**,只是 MM1-B1
# 的 Reference Provider。
#
# 认证方式(择一,不并存):
#   * subscription_key + region     (推荐,本机开发)
#   * managed identity              (生产,不适用本阶段)
#
# 空占位。**永远不要在本文件填入真实值。**
#
# FPAI_ 前缀是 Family SSOT 内部统一命名;
# AZURE_SPEECH_KEY / AZURE_SPEECH_REGION 是 Azure 官方 sample 常见命名,
# 保留兼容(SecretReader 会自动读取任一命名)。
#
#   FPAI_AZURE_SPEECH_KEY=
#   FPAI_AZURE_SPEECH_REGION=
#   AZURE_SPEECH_KEY=
#   AZURE_SPEECH_REGION=

# ---------------------------------------------------------------------------
# MM1-B1 · Reference Stack A · Voice selection
# ---------------------------------------------------------------------------
# LAB_REFERENCE_VOICE 用于选择 §11 Voice Rubric 试听的 Azure zh-CN 女声。
# 官方 zh-CN 女声候选(空占位,人类接手时按 §11 Rubric 试听后填一位):
#   FPAI_AZURE_TTS_VOICE=zh-CN-XiaoxiaoNeural
#   FPAI_AZURE_TTS_VOICE=zh-CN-XiaochenNeural
#   FPAI_AZURE_TTS_VOICE=zh-CN-XiaohanNeural
#
# 未选定时:代码内 default = 'zh-CN-XiaoxiaoNeural' (仅 LAB REFERENCE, 非 FINAL_FAMILI_VOICE)
FPAI_AZURE_TTS_VOICE=

# 情感/风格 override(留空 = 由 SpeechStyleMapper 从 PerformancePlan 推导)
FPAI_AZURE_TTS_STYLE=

# ---------------------------------------------------------------------------
# MM1-B1 · Recording / retention policy (§21 / §22)
# ---------------------------------------------------------------------------
# 默认 EPHEMERAL: microphone raw audio 不落盘,不进训练数据,不进 telemetry。
FPAI_AUDIO_RETENTION=EPHEMERAL
FPAI_BENCHMARK_AUDIO_RECORDING_CONSENT=NO

# ---------------------------------------------------------------------------
# MM1-B1 · DEV fallback (§30)
# ---------------------------------------------------------------------------
# 允许开发模式在真实 provider 不可用时显式切换到 Fake, 并写入 FALLBACK_PROVIDER_USED
# telemetry。**生产不得启用。**
FPAI_ALLOW_DEV_FAKE_FALLBACK=NO

# ---------------------------------------------------------------------------
# MM1-B1.1 · Real Speech Feature Flag (§H)
# ---------------------------------------------------------------------------
# 默认 NO。为 YES 时:
#   1. mm1b1.html 上的麦克风按钮才允许真正请求 getUserMedia。
#   2. speechCompositionRoot 才尝试构造 Azure SDK transport (需 credential 同时齐备)。
# 缺 credential 时的 YES 行为由 FPAI_ALLOW_DEV_FAKE_FALLBACK 决定:
#   * ALLOW=NO  → BLOCKED_MISSING_CREDENTIAL
#   * ALLOW=YES → FAKE_FALLBACK + FALLBACK_PROVIDER_USED=YES
FPAI_REAL_SPEECH_ENABLED=NO
