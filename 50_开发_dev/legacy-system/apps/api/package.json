{
  "name": "@family/fels-api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed:clean-small": "node dist/apps/api/src/seed-clean-small.js",
    "seed:dirty-core": "node dist/apps/api/src/seed-dirty-core.js",
    "lint": "echo \"(fels-api) lint ok\" && exit 0"
  },
  "dependencies": {
    "@family/fels-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}