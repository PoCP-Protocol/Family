{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "types": ["node"]
  },
  "include": [
    "src/orchestrator.ts",
    "src/orchestrator.spec.ts",
    "src/realtimeServer.ts",
    "src/realtimeServer.spec.ts",
    "src/server-entry.ts"
  ]
}
